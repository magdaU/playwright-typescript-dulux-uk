{
  "name": "playwright-typescript-dulux-uk",
  "version": "1.0.0",
  "description": "Playwright + TypeScript end-to-end tests for dulux.co.uk",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:desktop": "playwright test --project=desktop-chrome",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:api": "playwright test --project=api",
    "test:trace": "playwright test --trace on",
    "report": "playwright show-report",
    "allure:categories": "node -e \"require('fs').mkdirSync('allure-results',{recursive:true});require('fs').copyFileSync('allure/categories.json','allure-results/categories.json')\"",
    "allure:generate": "npm run allure:categories && allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magdaU/playwright-typescript-dulux-uk.git"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "dulux"
  ],
  "author": "Magdalena",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/magdaU/playwright-typescript-dulux-uk/issues"
  },
  "homepage": "https://github.com/magdaU/playwright-typescript-dulux-uk#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "allure-commandline": "^2.42.0",
    "allure-playwright": "^3.9.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
